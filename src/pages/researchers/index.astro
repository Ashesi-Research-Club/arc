---
import Base from '../../layouts/Base.astro';
import Avatar from '../../components/Avatar.astro';
import { getResearchers, getArticles } from '../../lib/supabase';

export const prerender = false;

const researchers = await getResearchers();
const articles = await getArticles();
const count = (researcherId: string) => articles.filter((a) => a.researcher_id === researcherId || a.researcher?.id === researcherId).length;
---
<Base title="Researchers — Ashesi Research Club">
  <main>
    <div class="eyebrow">The subjects</div>
    <h1>Profiled researchers</h1>
    <p class="lede">The people behind the work — every researcher the magazine has profiled.</p>
    <div class="roster">
      {researchers.map((r, i) => {
        const storyCount = count(r.id);
        return (
          <div>
            {i > 0 && <hr class="arc-rule" />}
            <a href={`/researchers/${r.slug}/`} class="person">
              <Avatar name={r.full_name} src={r.avatar_url} size={64} />
              <span>
                <span class="name">{r.full_name}</span>
                <span class="meta">{r.program} · {r.year_of_study}</span>
              </span>
              <span class="n">{storyCount} {storyCount === 1 ? 'story' : 'stories'} →</span>
            </a>
          </div>
        );
      })}
    </div>
  </main>
</Base>

<style>
  main { max-width: 900px; margin: 0 auto; padding: 48px 24px 96px; }
  .eyebrow {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--muted);
  }
  h1 { font-family: var(--font-display); font-weight: 400; font-size: 52px; line-height: 1.04; color: var(--ink); margin: 12px 0 8px; }
  .lede { font-family: var(--font-body); font-size: 19px; line-height: 1.55; color: var(--ink); max-width: 600px; }
  .roster { margin-top: 40px; }
  .person { display: grid; grid-template-columns: auto 1fr auto; gap: 24px; align-items: center; padding: 24px 0; text-decoration: none; }
  .name { display: block; font-family: var(--font-display); font-size: 24px; color: var(--ink); line-height: 1.1; }
  .meta { display: block; font-family: var(--font-sans); font-size: 13px; color: var(--muted); margin-top: 4px; }
  .n { font-family: var(--font-sans); font-size: 13px; font-weight: 600; color: var(--ink); white-space: nowrap; }

  @media (max-width: 767px) {
    main { padding: 32px 20px 72px; }
    h1 { font-size: 38px; }
    .person { gap: 16px; }
    .name { font-size: 20px; }
    .n { display: none; }
  }
</style>
