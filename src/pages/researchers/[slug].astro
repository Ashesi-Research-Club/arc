---
import Base from '../../layouts/Base.astro';
import Avatar from '../../components/Avatar.astro';
import CategoryEyebrow from '../../components/CategoryEyebrow.astro';
import Photo from '../../components/Photo.astro';
import { formatDate, minutes } from '../../lib/articles';
import { getResearcherBySlug, getArticles } from '../../lib/supabase';

export const prerender = false;

const { slug } = Astro.params;
const researcher = await getResearcherBySlug(slug as string);

if (!researcher) {
  return Astro.redirect('/404');
}

const allArticles = await getArticles();
const articles = allArticles.filter((a) => a.researcher_id === researcher.id || a.researcher?.slug === slug || a.researcher?.id === researcher.id);
---

<Base title={`${researcher.full_name} — Ashesi Research Club`} description={researcher.bio}>
  <main>
    <a href="/" class="back">← Ashesi Research Club</a>
    <div class="head">
      <Avatar name={researcher.full_name} src={researcher.avatar_url} size={96} />
      <div>
        <div class="eyebrow">Researcher</div>
        <h1>{researcher.full_name}</h1>
        <div class="meta">{researcher.program} · {researcher.year_of_study}</div>
      </div>
    </div>
    <p class="bio">{researcher.bio}</p>
    <div class="interests">
      {researcher.interests.map((t) => <span class="arc-tag">{t}</span>)}
    </div>

    <div class="featured-head">Featured in</div>
    {articles.length === 0 && (
      <p class="empty">No published stories feature {researcher.first_name || researcher.full_name} yet — profiles land here as they publish.</p>
    )}
    {articles.map((a) => (
      <article class="row">
        <div>
          <CategoryEyebrow category={a.category_id} />
          <h2><a href={`/articles/${a.slug}/`}>{a.title}</a></h2>
          <div class="row-meta">By {a.written_by} · {formatDate(a.published_date)} · {minutes(a)} min</div>
        </div>
        <a href={`/articles/${a.slug}/`} class="row-thumb" aria-hidden="true" tabindex="-1">
          <Photo src={a.featured_image} ratio="4/3" label="" />
        </a>
      </article>
    ))}
  </main>
</Base>

<style>
  main { max-width: 820px; margin: 0 auto; padding: 48px 24px 96px; }
  .back { font-family: var(--font-sans); font-size: 13px; font-weight: 600; color: var(--muted); text-decoration: none; }
  .head { display: flex; gap: 28px; align-items: center; margin: 28px 0 12px; }
  .eyebrow {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--muted);
  }
  h1 { font-family: var(--font-display); font-weight: 400; font-size: 46px; line-height: 1.04; color: var(--ink); margin: 6px 0; }
  .meta { font-family: var(--font-sans); font-size: 15px; color: var(--muted); }
  .bio { font-family: var(--font-body); font-size: 20px; line-height: 1.6; color: var(--ink); max-width: 640px; margin: 20px 0 28px; }
  .interests { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 40px; }
  .featured-head {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--muted);
    padding-bottom: 16px;
    border-bottom: 1px solid var(--ink);
  }
  .empty { font-family: var(--font-body); font-size: 16px; color: var(--muted); padding: 24px 0; }
  .row {
    display: grid;
    grid-template-columns: 1fr 120px;
    gap: 24px;
    padding: 22px 0;
    border-bottom: 1px solid var(--hairline);
    align-items: center;
  }
  .row h2 { font-family: var(--font-display); font-weight: 400; font-size: 26px; line-height: 1.12; margin: 8px 0 6px; }
  .row h2 a { color: var(--ink); text-decoration: none; }
  .row-meta { font-family: var(--font-sans); font-size: 13px; color: var(--muted); }
  .row-thumb { text-decoration: none; }

  @media (max-width: 767px) {
    main { padding: 32px 20px 72px; }
    .head { gap: 18px; }
    h1 { font-size: 32px; }
    .bio { font-size: 18px; }
  }
</style>
