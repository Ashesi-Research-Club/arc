---
import Base from '../../layouts/Base.astro';
import StoryRow from '../../components/StoryRow.astro';
import { CATEGORY_LABELS } from '../../lib/categories';
import { formatDate, minutes } from '../../lib/articles';
import { getArticles } from '../../lib/supabase';

export const prerender = false;

const articles = await getArticles();
const pills = [['all', 'All'], ...Object.entries(CATEGORY_LABELS)];
---
<Base title="Articles — Ashesi Research Club">
  <main>
    <h1>Articles</h1>

    <div class="arc-search">
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.2-3.2"/></svg>
      <input type="search" id="q" placeholder="Search articles…" aria-label="Search articles" />
      <button type="button" id="clear" aria-label="Clear search" hidden>×</button>
    </div>

    <div class="pills" role="group" aria-label="Filter by category">
      {pills.map(([k, l]) => (
        <button class="arc-pill" type="button" data-cat={k} aria-pressed={k === 'all' ? 'true' : 'false'}>{l}</button>
      ))}
    </div>

    <div id="list">
      {articles.map((a) => (
        <div
          class="hit"
          data-cat={a.category_id}
          data-hay={`${a.title} ${a.excerpt} ${a.tags?.join(' ') || ''}`.toLowerCase()}
        >
          <StoryRow
            href={`/articles/${a.slug}/`}
            title={a.title}
            category={a.category_id}
            excerpt={a.excerpt}
            writtenBy={a.written_by}
            date={formatDate(a.published_date)}
            readTime={minutes(a)}
            image={a.featured_image}
          />
        </div>
      ))}
    </div>

    <div id="empty" hidden>
      <div class="e-head">Nothing here yet</div>
      <div class="e-sub">No articles match “<span id="eq"></span>”. Try another keyword or category.</div>
    </div>
  </main>
</Base>

<style>
  main { max-width: 1000px; margin: 0 auto; padding: 48px 24px 96px; }
  h1 { font-family: var(--font-display); font-weight: 400; font-size: 48px; line-height: 1.04; color: var(--ink); margin: 0 0 24px; }
  .arc-search { max-width: 460px; margin-bottom: 20px; }
  #clear { border: none; background: transparent; cursor: pointer; color: var(--muted); font-family: var(--font-sans); font-size: 18px; line-height: 1; padding: 4px; }
  .pills { display: flex; flex-wrap: wrap; gap: 8px; padding-bottom: 28px; border-bottom: 1px solid var(--ink); }
  #empty { padding: 64px 0; text-align: center; }
  .e-head { font-family: var(--font-display); font-size: 28px; color: var(--ink); margin-bottom: 8px; }
  .e-sub { font-family: var(--font-body); font-size: 16px; color: var(--muted); }

  @media (max-width: 767px) {
    main { padding: 32px 20px 72px; }
    h1 { font-size: 36px; }
  }
</style>

<script>
  const q = document.getElementById('q') as HTMLInputElement;
  const clear = document.getElementById('clear')!;
  const empty = document.getElementById('empty')!;
  const eq = document.getElementById('eq')!;
  const hits = [...document.querySelectorAll<HTMLElement>('.hit')];
  const pills = [...document.querySelectorAll<HTMLElement>('.arc-pill')];
  let cat = 'all';

  const apply = () => {
    const needle = q.value.trim().toLowerCase();
    clear.toggleAttribute('hidden', !needle);
    let shown = 0;
    for (const h of hits) {
      const ok = (cat === 'all' || h.dataset.cat === cat) && (h.dataset.hay ?? '').includes(needle);
      h.toggleAttribute('hidden', !ok);
      if (ok) shown++;
    }
    eq.textContent = q.value;
    empty.toggleAttribute('hidden', shown > 0);
  };

  q.addEventListener('input', apply);
  clear.addEventListener('click', () => { q.value = ''; apply(); });
  pills.forEach((p) =>
    p.addEventListener('click', () => {
      cat = p.dataset.cat ?? 'all';
      pills.forEach((x) => x.setAttribute('aria-pressed', String(x === p)));
      apply();
    })
  );
</script>
