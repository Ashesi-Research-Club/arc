---
import Base from '../../layouts/Base.astro';
import Byline from '../../components/Byline.astro';
import CategoryEyebrow from '../../components/CategoryEyebrow.astro';
import Avatar from '../../components/Avatar.astro';
import Photo from '../../components/Photo.astro';
import BlockRenderer from '../../components/BlockRenderer.astro';
import { getArticleBySlug } from '../../lib/supabase';
import { getEntry, render } from 'astro:content';
import { minutes } from '../../lib/articles';

export const prerender = false;

const { slug } = Astro.params;
const article = await getArticleBySlug(slug as string);

if (!article) {
  return Astro.redirect('/404');
}

// Check if content is dynamic blocks or fallback MDX entry
let MdxContent = null;
let researcherData = article.researcher;

if (!researcherData && article.researcher_id) {
  const entry = await getEntry('researchers', article.researcher_id as any);
  if (entry) {
    researcherData = {
      id: entry.id,
      slug: entry.id,
      full_name: entry.data.name,
      program: entry.data.program,
      year_of_study: entry.data.yearOfStudy,
      bio: entry.data.bio,
      avatar_url: entry.data.avatar,
      interests: entry.data.interests,
      status: 'active'
    };
  }
}

// Fallback MDX render if no JSONB blocks exist
if (!article.blocks || article.blocks.length === 0) {
  const mdxEntry = await getEntry('articles', slug as any);
  if (mdxEntry) {
    const rendered = await render(mdxEntry);
    MdxContent = rendered.Content;
  }
}

const readMins = minutes(article);
const finePrint = [
  article.collaborators && `Collaborators: ${article.collaborators}`,
  article.funding_source && `Funding: ${article.funding_source}`,
]
  .filter(Boolean)
  .join(' · ');
---

<Base title={`${article.title} — Ashesi Research Club`} description={article.excerpt}>
  <div class="progress" aria-hidden="true"><div class="bar"></div></div>

  <main>
    <div class="head-row">
      <CategoryEyebrow category={article.category_id} />
      <!-- Language switcher header toggle — EN default; FR & Twi on backlog -->
      <div class="langs" aria-label="Article language">
        <span class="on">EN</span><span>FR</span><span>Twi</span>
      </div>
    </div>

    <h1>{article.title}</h1>
    <p class="standfirst">{article.excerpt}</p>

    <div class="byline-row">
      <Byline
        writer={article.written_by}
        date={article.published_date}
        readTime={readMins}
      />
      <div class="tools">
        {article.audio_url && (
          <button class="arc-iconbtn listen" data-shape="circle" data-variant="outline" aria-label="Listen to this article" aria-expanded="false">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M7 5v14l11-7z"/></svg>
          </button>
        )}
        <button class="arc-iconbtn settings" data-shape="circle" data-variant="outline" aria-label="Reader settings" aria-expanded="false">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 7h10M5 7a2 2 0 1 0 4 0 2 2 0 0 0-4 0M15 17h4M5 17h6M15 17a2 2 0 1 0 4 0 2 2 0 0 0-4 0M19 7h-2"/></svg>
        </button>
      </div>
    </div>

    <!-- Audio Player scaffold — only renders if article has audio_url -->
    {article.audio_url && (
      <div class="player" hidden>
        <audio id="article-audio" src={article.audio_url} preload="metadata"></audio>
        <button type="button" class="arc-iconbtn play-audio-btn" data-shape="circle" data-variant="filled" style="width:36px;height:36px" aria-label="Play or pause audio">
          <span class="play-icon" style="font-size:11px">▶</span>
        </button>
        <div class="track"><div class="track-progress" style="width:0%"></div></div>
        <span class="time"><span class="current-time">0:00</span> / {article.audio_duration || `${readMins}:00`}</span>
      </div>
    )}

    <div class="settings-panel" hidden>
      <div class="panel-head">Reader settings</div>
      {[
        ['Body type', ['Serif', 'Sans']],
        ['Text size', ['A−', 'A', 'A+']],
        ['Background', ['White', 'Warm', 'Dark']],
      ].map(([labelText, opts], row) => (
        <div class="row">
          <span>{labelText}</span>
          <div class="seg">
            {(opts as string[]).map((o, i) => (
              <button type="button" class:list={{ on: i === (row === 1 ? 1 : 0) }} aria-disabled="true" title="Coming soon">{o}</button>
            ))}
          </div>
        </div>
      ))}
    </div>

    {article.featured_image && (
      <figure class="hero arc-reveal">
        <Photo src={article.featured_image} ratio="16/9" label="Featured image" />
        <figcaption>
          {researcherData?.full_name} — {researcherData?.program}. Photograph for the Ashesi Research Club.
        </figcaption>
      </figure>
    )}

    <div class="prose">
      {article.blocks && article.blocks.length > 0 ? (
        <BlockRenderer blocks={article.blocks} />
      ) : MdxContent ? (
        <MdxContent />
      ) : (
        <p>{article.excerpt}</p>
      )}
    </div>

    <!-- Applause — persistence via Supabase API -->
    <div class="applause">
      <button class="arc-iconbtn clap" data-shape="circle" data-variant="outline" style="width:56px;height:56px" aria-label="Applaud" data-id={article.id}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M11 11V5.5a1.5 1.5 0 0 1 3 0V11"/><path d="M14 10V4.5a1.5 1.5 0 0 1 3 0V12"/><path d="M17 11.5V7a1.5 1.5 0 0 1 3 0v6a7 7 0 0 1-7 7h-1.5a6 6 0 0 1-5-2.7L4 13a1.6 1.6 0 0 1 2.7-1.7L8 13V6.5a1.5 1.5 0 0 1 3 0V11"/></svg>
      </button>
      <div class="count"><span class="n">{article.claps || 0}</span> applause</div>
    </div>

    {finePrint && <div class="fine">{finePrint}</div>}

    {researcherData && (
      <a href={`/researchers/${researcherData.slug}/`} class="researcher-card">
        <Avatar name={researcherData.full_name} src={researcherData.avatar_url} size={64} />
        <span>
          <span class="rc-eyebrow">The researcher</span>
          <span class="rc-name">{researcherData.full_name}</span>
          <span class="rc-meta">{researcherData.program} · {researcherData.year_of_study} →</span>
        </span>
      </a>
    )}
  </main>
</Base>

<style>
  .progress {
    position: sticky;
    top: 76px;
    height: 3px;
    background: var(--hairline);
    z-index: 20;
  }
  .progress .bar { height: 100%; width: 0%; background: var(--ink); transition: width 80ms linear; }

  main { max-width: var(--reading-max); margin: 0 auto; padding: 48px 24px 96px; }

  .head-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
  .langs { display: flex; gap: 2px; font-family: var(--font-sans); font-size: 12px; font-weight: 600; }
  .langs span { padding: 4px 8px; color: var(--muted); border-bottom: 2px solid transparent; cursor: pointer; }
  .langs .on { color: var(--ink); border-bottom-color: var(--ink); }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 46px;
    line-height: 1.05;
    letter-spacing: var(--track-tight);
    color: var(--ink);
    margin: 0 0 20px;
  }
  .standfirst {
    font-family: var(--font-body);
    font-size: 21px;
    line-height: var(--body-line-tight);
    color: var(--ink);
    font-style: italic;
    margin: 0 0 26px;
  }

  .byline-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--hairline);
  }
  .tools { display: flex; gap: 6px; }
  .tools .arc-iconbtn[aria-expanded='true'] { background: var(--ink); color: var(--on-ink); }

  .player { display: flex; align-items: center; gap: 14px; border: 1px solid var(--ink); padding: 12px 16px; margin-top: 18px; }
  .player .track { flex: 1; height: 3px; background: var(--hairline); overflow: hidden; }
  .player .track-progress { height: 100%; background: var(--ink); transition: width 100ms linear; }
  .player .time { font-family: var(--font-mono); font-size: 12px; color: var(--muted); }

  .settings-panel { border: 1px solid var(--ink); padding: 18px; margin-top: 18px; background: var(--canvas); }
  .panel-head {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .settings-panel .row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
  .settings-panel .row:last-child { margin-bottom: 0; }
  .settings-panel .row > span { font-family: var(--font-sans); font-size: 13px; }
  .seg { display: flex; border: 1px solid var(--ink); }
  .seg button {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    padding: 6px 12px;
    cursor: default;
    border: none;
    background: transparent;
    color: var(--ink);
  }
  .seg button + button { border-left: 1px solid var(--ink); }
  .seg button.on { background: var(--ink); color: var(--on-ink); }

  .hero { margin: 30px 0; }
  .hero figcaption { font-family: var(--font-sans); font-size: 13px; color: var(--muted); margin-top: 8px; }

  .prose { margin: 36px 0; }

  .applause {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin: 56px 0;
    padding-top: 40px;
    border-top: 1px solid var(--hairline);
  }
  .applause .clap[data-clapped] { background: var(--ink); color: var(--on-ink); }
  .count { font-family: var(--font-sans); font-size: 14px; font-weight: 600; color: var(--ink); }

  .fine {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--muted);
    border-top: 1px solid var(--hairline);
    padding-top: 16px;
  }

  .researcher-card {
    display: flex;
    gap: 18px;
    align-items: center;
    border: 1px solid var(--ink);
    padding: 20px;
    margin-top: 28px;
    text-decoration: none;
  }
  .rc-eyebrow {
    display: block;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--muted);
  }
  .rc-name { display: block; font-family: var(--font-display); font-size: 24px; color: var(--ink); margin: 4px 0; }
  .rc-meta { display: block; font-family: var(--font-sans); font-size: 13px; color: var(--muted); }

  @media (max-width: 767px) {
    main { padding: 32px 20px 72px; }
    h1 { font-size: 32px; }
    .standfirst { font-size: 19px; }
  }
</style>

<script>
  // Scroll progress
  const bar = document.querySelector<HTMLElement>('.progress .bar');
  const onScroll = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    if (bar) bar.style.width = `${max > 0 ? Math.min(100, (window.scrollY / max) * 100) : 0}%`;
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Slot toggles: audio player & settings
  const wire = (btnSel: string, panelSel: string) => {
    const btn = document.querySelector(btnSel);
    const panel = document.querySelector(panelSel);
    btn?.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      panel?.toggleAttribute('hidden', open);
    });
  };
  wire('.listen', '.player');
  wire('.settings', '.settings-panel');

  // Interactive HTML5 Audio Player
  const audio = document.querySelector<HTMLAudioElement>('#article-audio');
  const playBtn = document.querySelector<HTMLElement>('.play-audio-btn');
  const playIcon = document.querySelector<HTMLElement>('.play-icon');
  const trackProgress = document.querySelector<HTMLElement>('.track-progress');
  const currentTimeEl = document.querySelector<HTMLElement>('.current-time');

  if (audio && playBtn && playIcon && trackProgress) {
    playBtn.addEventListener('click', () => {
      if (audio.paused) {
        audio.play();
        playIcon.textContent = '❚❚';
      } else {
        audio.pause();
        playIcon.textContent = '▶';
      }
    });

    audio.addEventListener('timeupdate', () => {
      if (!audio.duration) return;
      const pct = (audio.currentTime / audio.duration) * 100;
      trackProgress.style.width = `${pct}%`;
      const mins = Math.floor(audio.currentTime / 60);
      const secs = Math.floor(audio.currentTime % 60).toString().padStart(2, '0');
      if (currentTimeEl) currentTimeEl.textContent = `${mins}:${secs}`;
    });

    audio.addEventListener('ended', () => {
      playIcon.textContent = '▶';
      trackProgress.style.width = '0%';
    });
  }

  // Applause API connection
  const clapBtn = document.querySelector<HTMLElement>('.clap');
  const countEl = document.querySelector<HTMLElement>('.count .n');

  if (clapBtn && countEl) {
    clapBtn.addEventListener('click', async () => {
      const articleId = clapBtn.dataset.id;
      if (!articleId) return;

      const current = parseInt(countEl.textContent || '0', 10);
      countEl.textContent = String(current + 1);
      clapBtn.setAttribute('data-clapped', '');

      try {
        await fetch('/api/clap', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ articleId })
        });
      } catch (e) {
        console.error('Failed to increment clap', e);
      }
    });
  }
</script>
