---
import Base from '../layouts/Base.astro';
import Byline from '../components/Byline.astro';
import CategoryEyebrow from '../components/CategoryEyebrow.astro';
import Avatar from '../components/Avatar.astro';
import Photo from '../components/Photo.astro';
import { label } from '../lib/categories';
import { formatDate, minutes } from '../lib/articles';
import { getArticles, getResearchers } from '../lib/supabase';

export const prerender = false;

const articles = await getArticles();
const cover = articles.find((a) => a.featured) ?? articles[0];
const secondary = articles.filter((a) => a.id !== cover?.id);
const researchers = await getResearchers();
---

<Base>
  <main>
    {cover && (
      <article class="cover arc-reveal">
        <a href={`/articles/${cover.slug}/`} class="cover-media">
          <Photo src={cover.featured_image} ratio="16/9" label={`Cover · ${label(cover.category_id)}`} />
        </a>
        <div class="cover-text">
          <CategoryEyebrow category={cover.category_id} />
          <h1><a href={`/articles/${cover.slug}/`}>{cover.title}</a></h1>
          <p>{cover.excerpt}</p>
          <div class="cover-byline">
            <Byline writer={cover.written_by} date={formatDate(cover.published_date)} readTime={minutes(cover)} />
          </div>
        </div>
      </article>
    )}

    <hr class="arc-rule" />

    <div class="below">
      <section>
        <div class="col-head">Latest</div>
        {secondary.length === 0 && (
          <p class="empty">More stories are on the way — the desk is writing.</p>
        )}
        {secondary.map((a) => (
          <article class="secondary">
            <a href={`/articles/${a.slug}/`} aria-hidden="true" tabindex="-1">
              <Photo src={a.featured_image} ratio="4/3" label={label(a.category_id)} />
            </a>
            <div>
              <CategoryEyebrow category={a.category_id} />
              <h2><a href={`/articles/${a.slug}/`}>{a.title}</a></h2>
              <p>{a.excerpt}</p>
              <div class="sec-byline">
                <Byline writer={a.written_by} date={formatDate(a.published_date)} readTime={minutes(a)} size="sm" />
              </div>
            </div>
          </article>
        ))}
      </section>

      <aside>
        <div class="col-head">Profiled researchers</div>
        {researchers.map((p, i) => (
          <div>
            <a href={`/researchers/${p.slug}/`} class="rail-person">
              <Avatar name={p.full_name} src={p.avatar_url} size={48} />
              <span>
                <span class="rail-name">{p.full_name}</span>
                <span class="rail-meta">{p.program} · {p.year_of_study}</span>
              </span>
            </a>
            {i < researchers.length - 1 && <hr class="arc-rule rail-rule" />}
          </div>
        ))}
        <div class="join">
          <div class="col-head">Join the desk</div>
          <p>Researching something worth telling? Pitch it to the club.</p>
          <a href="/apply/" class="arc-button" data-variant="secondary">Apply to publish</a>
        </div>
      </aside>
    </div>
  </main>
</Base>

<style>
  main {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--pad-page-x) 80px;
  }
  .cover { padding-top: 40px; }
  .cover-media { display: block; text-decoration: none; }
  .cover-text { width: 100%; max-width: 100%; margin-top: 26px; }
  .cover h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 54px;
    line-height: 1.08;
    letter-spacing: var(--track-tight);
    margin: 14px 0 0;
    width: 100%;
    max-width: 100%;
  }
  .cover h1 a { color: var(--ink); text-decoration: none; }
  .cover p {
    font-family: var(--font-body);
    font-size: 20px;
    line-height: 1.5;
    color: var(--ink);
    margin: 18px 0 0;
    width: 100%;
    max-width: 100%;
  }
  .cover-byline { margin-top: 22px; }
  main > .arc-rule { margin: 56px 0; }

  .below { display: grid; grid-template-columns: 1.7fr 1fr; gap: 56px; }
  .col-head {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 22px;
  }
  .secondary {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 28px;
    align-items: start;
  }
  .secondary + .secondary { margin-top: 40px; }
  .secondary h2 { font-family: var(--font-display); font-weight: 400; font-size: 30px; line-height: 1.1; margin: 10px 0 0; }
  .secondary h2 a { color: var(--ink); text-decoration: none; }
  .secondary p { font-family: var(--font-body); font-size: 16px; line-height: 1.55; color: var(--ink); margin: 12px 0 0; }
  .sec-byline { margin-top: 16px; }
  .empty { font-family: var(--font-body); font-size: 16px; color: var(--muted); }

  aside { border-left: 1px solid var(--hairline); padding-left: 32px; }
  .rail-person { display: flex; gap: 14px; padding: 4px 0; text-decoration: none; }
  .rail-name { display: block; font-family: var(--font-display); font-size: 19px; line-height: 1.15; color: var(--ink); }
  .rail-meta { display: block; font-family: var(--font-sans); font-size: 13px; color: var(--muted); margin-top: 3px; }
  .rail-rule { margin: 18px 0; }
  .join { margin-top: 28px; }
  .join p { font-family: var(--font-body); font-size: 15px; line-height: 1.55; color: var(--ink); margin: 0 0 16px; }

  @media (max-width: 1023px) {
    .below { grid-template-columns: 1fr; gap: 48px; }
    aside { border-left: none; padding-left: 0; border-top: 1px solid var(--hairline); padding-top: 32px; }
  }
  @media (max-width: 767px) {
    .cover { padding-top: 24px; }
    .cover h1 { font-size: var(--display-hero-mobile); }
    .cover p { font-size: 18px; }
    main > .arc-rule { margin: 40px 0; }
    .secondary { grid-template-columns: 1fr; gap: 16px; }
    .secondary h2 { font-size: 26px; }
  }
</style>
