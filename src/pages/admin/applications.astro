---
import Base from '../../layouts/Base.astro';
import { supabase } from '../../lib/supabase';

export const prerender = false;

let applications: any[] = [];
if (supabase) {
  const { data } = await supabase.from('applications').select('*').order('submitted_at', { ascending: false });
  applications = data || [];
}
---

<Base title="Pitch Submissions Inbox — ARC Editorial Admin">
  <main>
    <div class="nav-bar">
      <a href="/admin/" class="back-link">← Editorial Desk</a>
      <div class="stats-badge">{applications.length} Total Applications</div>
    </div>

    <div class="eyebrow">Submissions Inbox</div>
    <h1>Research Pitch Submissions</h1>
    <p class="lede">Review incoming student pitches submitted through the public /apply research form.</p>

    <!-- Pitch Inbox Table -->
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Applicant Name</th>
            <th>Research Title</th>
            <th>Category & Stage</th>
            <th>Submitted Date</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {applications.map((app) => (
            <tr data-id={app.id}>
              <td>
                <div class="app-name">{app.applicant_name}</div>
                <div class="app-sub">{app.email} · {app.program} ({app.year_of_study})</div>
              </td>
              <td>
                <div class="art-title">{app.research_title}</div>
                {app.research_advisor && <div class="art-meta">Advisor: {app.research_advisor}</div>}
              </td>
              <td>
                <span class="arc-tag">{app.research_category}</span>
                <div class="art-meta" style="margin-top: 4px;">{app.project_stage}</div>
              </td>
              <td class="date-cell">{new Date(app.submitted_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</td>
              <td>
                <select class="status-select arc-input" data-id={app.id} style="padding: 4px 8px; font-size: 12px;">
                  <option value="pending" selected={app.status === 'pending'}>Pending</option>
                  <option value="under_review" selected={app.status === 'under_review'}>Under Review</option>
                  <option value="accepted" selected={app.status === 'accepted'}>Accepted</option>
                  <option value="declined" selected={app.status === 'declined'}>Declined</option>
                </select>
              </td>
              <td>
                <button type="button" class="arc-button view-app-btn" data-variant="secondary" style="font-size: 12px; padding: 4px 10px;" data-json={JSON.stringify(app)}>View Pitch</button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Modal Form for Inspecting Application Details -->
    <div id="app-modal" class="modal-backdrop" hidden>
      <div class="modal-card">
        <div class="modal-head">
          <h2>Application Pitch Details</h2>
          <button type="button" id="close-app-btn" class="close-btn">✕</button>
        </div>

        <div id="app-detail-content">
          <!-- Dynamically populated via JS -->
        </div>
      </div>
    </div>
  </main>
</Base>

<style>
  main { max-width: 1080px; margin: 0 auto; padding: 48px 24px 96px; }
  .nav-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
  .back-link { font-family: var(--font-sans); font-size: 13px; font-weight: 600; color: var(--muted); text-decoration: none; }
  .stats-badge { font-family: var(--font-sans); font-size: 12px; font-weight: 700; background: var(--ink); color: #fff; padding: 4px 10px; }

  .eyebrow { font-family: var(--font-sans); font-size: 13px; font-weight: 700; letter-spacing: var(--track-label); text-transform: uppercase; color: var(--muted); }
  h1 { font-family: var(--font-display); font-weight: 400; font-size: 44px; color: var(--ink); margin: 8px 0; }
  .lede { font-family: var(--font-body); font-size: 18px; color: var(--muted); margin-bottom: 32px; }

  .table-wrap { border: 1px solid var(--ink); background: #fff; overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; text-align: left; }
  th { font-family: var(--font-sans); font-size: 11px; font-weight: 700; letter-spacing: var(--track-label); text-transform: uppercase; background: #f4f4f4; padding: 14px 16px; border-bottom: 1px solid var(--ink); }
  td { padding: 16px; border-bottom: 1px solid var(--hairline); font-family: var(--font-sans); font-size: 14px; }
  
  .app-name { font-family: var(--font-display); font-size: 18px; color: var(--ink); }
  .app-sub { font-size: 12px; color: var(--muted); margin-top: 2px; }
  .art-title { font-family: var(--font-body); font-weight: 600; font-size: 15px; color: var(--ink); max-width: 260px; line-height: 1.25; }
  .art-meta { font-size: 12px; color: var(--muted); }
  .date-cell { font-size: 13px; color: var(--muted); white-space: nowrap; }

  .modal-backdrop {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
  }
  .modal-backdrop[hidden] { display: none !important; }
  .modal-card { background: #fff; border: 1px solid var(--ink); width: 90%; max-width: 680px; padding: 28px; max-height: 90vh; overflow-y: auto; }
  .modal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid var(--ink); padding-bottom: 12px; }
  .modal-head h2 { font-family: var(--font-display); font-size: 24px; font-weight: 400; margin: 0; }
  .close-btn { border: none; background: transparent; font-size: 20px; cursor: pointer; color: var(--muted); }

  @media (max-width: 767px) {
    main { padding: 32px 20px 72px; }
  }
</style>

<script>
  const code = sessionStorage.getItem('arc_admin_passcode');
  if (!code) window.location.href = '/admin/';

  const modal = document.getElementById('app-modal')!;
  const content = document.getElementById('app-detail-content')!;
  const closeBtn = document.getElementById('close-app-btn')!;

  closeBtn.addEventListener('click', () => modal.setAttribute('hidden', ''));

  document.querySelectorAll('.view-app-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const data = JSON.parse(btn.getAttribute('data-json') || '{}');
      content.innerHTML = `
        <div style="font-family: var(--font-sans); margin-bottom: 20px;">
          <div style="font-size: 12px; color: var(--muted); text-transform: uppercase; font-weight: 700;">APPLICANT</div>
          <div style="font-family: var(--font-display); font-size: 22px; margin: 2px 0;">${data.applicant_name}</div>
          <div style="font-size: 13px; color: var(--muted);">${data.email} · ${data.phone}</div>
          <div style="font-size: 13px; color: var(--muted);">${data.program} · ${data.year_of_study} ${data.research_advisor ? `(Advisor: ${data.research_advisor})` : ''}</div>
        </div>

        <div style="border-top: 1px solid var(--hairline); padding-top: 16px; margin-bottom: 16px;">
          <div style="font-size: 12px; color: var(--muted); text-transform: uppercase; font-weight: 700;">RESEARCH TITLE</div>
          <div style="font-family: var(--font-display); font-size: 20px; margin: 4px 0;">${data.research_title}</div>
          <div style="font-size: 13px;">Category: <strong>${data.research_category}</strong> · Stage: <strong>${data.project_stage}</strong></div>
        </div>

        <div style="margin-bottom: 16px;">
          <div style="font-size: 12px; color: var(--muted); text-transform: uppercase; font-weight: 700; margin-bottom: 4px;">ABSTRACT</div>
          <div style="font-family: var(--font-body); font-size: 15px; line-height: 1.5; background: #fafafa; padding: 12px; border: 1px solid var(--hairline);">${data.abstract}</div>
        </div>

        <div style="margin-bottom: 16px;">
          <div style="font-size: 12px; color: var(--muted); text-transform: uppercase; font-weight: 700; margin-bottom: 4px;">REAL-WORLD IMPACT</div>
          <div style="font-family: var(--font-body); font-size: 15px; line-height: 1.5; background: #fafafa; padding: 12px; border: 1px solid var(--hairline);">${data.real_world_impact}</div>
        </div>

        <div style="margin-bottom: 16px;">
          <div style="font-size: 12px; color: var(--muted); text-transform: uppercase; font-weight: 700; margin-bottom: 4px;">PUBLISHING MOTIVATION</div>
          <div style="font-family: var(--font-body); font-size: 15px; line-height: 1.5;">${data.motivation || 'N/A'}</div>
        </div>

        ${data.supporting_materials_url ? `
          <div style="margin-bottom: 16px;">
            <div style="font-size: 12px; color: var(--muted); text-transform: uppercase; font-weight: 700; margin-bottom: 4px;">SUPPORTING MATERIALS</div>
            <a href="${data.supporting_materials_url}" target="_blank" style="font-family: var(--font-sans); font-size: 13px; color: var(--ink);">${data.supporting_materials_url}</a>
          </div>
        ` : ''}
      `;
      modal.removeAttribute('hidden');
    });
  });

  // Status Change Handler
  document.querySelectorAll('.status-select').forEach(sel => {
    sel.addEventListener('change', async () => {
      const selectEl = sel as HTMLSelectElement;
      const appId = selectEl.dataset.id;
      const newStatus = selectEl.value;

      try {
        const res = await fetch('/api/admin/applications', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ passcode: code, applicationId: appId, status: newStatus })
        });
        const data = await res.json();
        if (!data.success) {
          alert(`Status update failed: ${data.error}`);
        }
      } catch (err) {
        alert('Error updating application status');
      }
    });
  });
</script>
