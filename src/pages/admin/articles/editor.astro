---
import Base from '../../../layouts/Base.astro';
import Field from '../../../components/Field.astro';
import { CATEGORY_LABELS } from '../../../lib/categories';
import { getArticleBySlug, getCategories, getResearchers, getArticles, supabase } from '../../../lib/supabase';

export const prerender = false;

const url = new URL(Astro.request.url);
const articleId = url.searchParams.get('id');

const categories = await getCategories();
const researchers = await getResearchers();

let articleData = null;

if (articleId && supabase) {
  const { data } = await supabase.from('articles').select('*, researcher:researchers(*), category:categories(*)').eq('id', articleId).single();
  if (data) {
    const { data: blocks } = await supabase.from('article_blocks').select('*').eq('article_id', articleId).order('order_index', { ascending: true });
    data.blocks = blocks || [];
    articleData = data;
  }
}
---

<Base title={articleData ? `Editing ${articleData.title} — ARC Admin` : 'Create New Article — ARC Admin'}>
  <main>
    <div class="nav-bar">
      <a href="/admin/articles/" class="back-link">← Back to Articles Desk</a>
      <button type="button" id="save-article-btn" class="arc-button" data-variant="primary">Save & Publish Article</button>
    </div>

    <div class="eyebrow">{articleData ? 'Edit Article' : 'New Article'}</div>
    <h1>{articleData ? 'Edit Article & Blocks' : 'Create Article'}</h1>
    <p class="lede">Fill out metadata and construct your editorial piece using visual content blocks.</p>

    <form id="editor-form" data-id={articleData?.id || ''}>
      <!-- SECTION 1: METADATA -->
      <div class="section-box">
        <div class="section-title">01. Article Metadata</div>
        <div class="grid2">
          <Field label="Article Title" htmlFor="art-title" required>
            <input class="arc-input" id="art-title" name="title" value={articleData?.title || ''} placeholder="e.g. Did Dr. Nyantakyi Just Replace GPS?" required />
          </Field>
          <Field label="URL Slug" htmlFor="art-slug" hint="Unique URL path" required>
            <input class="arc-input" id="art-slug" name="slug" value={articleData?.slug || ''} placeholder="did-dr-nyantakyi-just-replace-gps" required />
          </Field>
        </div>

        <Field label="Excerpt / Standfirst" htmlFor="art-excerpt" hint="A short 2-3 sentence summary" required>
          <textarea class="arc-input" id="art-excerpt" name="excerpt" rows="3" required>{articleData?.excerpt || ''}</textarea>
        </Field>

        <div class="grid3">
          <Field label="Category" htmlFor="art-cat" required>
            <select class="arc-input" id="art-cat" name="category_id" required>
              {categories.map((c) => (
                <option value={c.id} selected={c.id === articleData?.category_id}>{c.name}</option>
              ))}
            </select>
          </Field>

          <Field label="Featured Researcher" htmlFor="art-res" required>
            <select class="arc-input" id="art-res" name="researcher_id" required>
              {researchers.map((r) => (
                <option value={r.id} selected={r.id === articleData?.researcher_id}>{r.full_name}</option>
              ))}
            </select>
          </Field>

          <Field label="Written By" htmlFor="art-writer" required>
            <input class="arc-input" id="art-writer" name="written_by" value={articleData?.written_by || 'Sinam Afi Serwa Ametewee'} required />
          </Field>
        </div>

        <div class="grid3">
          <Field label="Published Date" htmlFor="art-date" required>
            <input class="arc-input" id="art-date" name="published_date" type="date" value={articleData?.published_date || new Date().toISOString().split('T')[0]} required />
          </Field>

          <Field label="Featured Image URL" htmlFor="art-img" hint="Cloudinary / Web URL">
            <input class="arc-input" id="art-img" name="featured_image" value={articleData?.featured_image || ''} placeholder="https://res.cloudinary.com/..." />
          </Field>

          <Field label="Featured Story?" htmlFor="art-feat">
            <label class="check-label">
              <input type="checkbox" id="art-feat" name="featured" checked={articleData?.featured || false} />
              <span>Display as Homepage Cover Story</span>
            </label>
          </Field>
        </div>

        <div class="grid2">
          <Field label="Audio Recording URL" htmlFor="art-audio" hint="Optional Cloudinary audio link">
            <input class="arc-input" id="art-audio" name="audio_url" value={articleData?.audio_url || ''} placeholder="https://res.cloudinary.com/.../audio.mp3" />
          </Field>

          <Field label="Audio Duration" htmlFor="art-aud-dur" hint="e.g. 03:45">
            <input class="arc-input" id="art-aud-dur" name="audio_duration" value={articleData?.audio_duration || ''} placeholder="03:45" />
          </Field>
        </div>
      </div>

      <!-- SECTION 2: VISUAL BLOCK BUILDER -->
      <div class="section-box">
        <div class="section-head-row">
          <div class="section-title">02. Visual Article Content Blocks</div>
          <div class="block-add-buttons">
            <button type="button" class="add-block-btn" data-type="paragraph">+ Paragraph</button>
            <button type="button" class="add-block-btn" data-type="heading">+ Heading</button>
            <button type="button" class="add-block-btn" data-type="pullquote">+ PullQuote</button>
            <button type="button" class="add-block-btn" data-type="callout">+ TL;DR Callout</button>
            <button type="button" class="add-block-btn" data-type="checkpoint">+ Quiz Checkpoint</button>
            <button type="button" class="add-block-btn" data-type="code">+ Code Block</button>
          </div>
        </div>

        <div id="blocks-container" class="blocks-container">
          <!-- Dynamically populated via client JS -->
        </div>
      </div>
    </form>
  </main>
</Base>

<style>
  main { max-width: 1000px; margin: 0 auto; padding: 48px 24px 96px; }
  .nav-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
  .back-link { font-family: var(--font-sans); font-size: 13px; font-weight: 600; color: var(--muted); text-decoration: none; }

  .eyebrow {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--muted);
  }
  h1 { font-family: var(--font-display); font-weight: 400; font-size: 44px; color: var(--ink); margin: 8px 0; }
  .lede { font-family: var(--font-body); font-size: 18px; color: var(--muted); margin-bottom: 32px; }

  .section-box { border: 1px solid var(--ink); padding: 24px; margin-bottom: 32px; background: #fff; }
  .section-title { font-family: var(--font-sans); font-size: 12px; font-weight: 700; letter-spacing: var(--track-label); text-transform: uppercase; color: var(--muted); margin-bottom: 18px; }
  
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .grid3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 18px; }
  select.arc-input { appearance: none; min-height: var(--touch-min); }

  .check-label { display: flex; align-items: center; gap: 10px; font-family: var(--font-sans); font-size: 14px; margin-top: 28px; cursor: pointer; }

  .section-head-row { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
  .block-add-buttons { display: flex; gap: 8px; flex-wrap: wrap; }
  .add-block-btn {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    padding: 6px 12px;
    border: 1px solid var(--ink);
    background: #fafafa;
    color: var(--ink);
    cursor: pointer;
  }
  .add-block-btn:hover { background: var(--ink); color: #fff; }

  .blocks-container { display: flex; flex-direction: column; gap: 18px; }

  @media (max-width: 767px) {
    main { padding: 32px 20px 72px; }
    .grid2, .grid3 { grid-template-columns: 1fr; }
  }
</style>

<script is:inline define:vars={{ initialBlocks: articleData?.blocks || [] }}>
  const code = sessionStorage.getItem('arc_admin_passcode');
  if (!code) {
    window.location.href = '/admin/';
  }

  const container = document.getElementById('blocks-container');
  const titleInput = document.getElementById('art-title');
  const slugInput = document.getElementById('art-slug');
  let blocks = initialBlocks.map(b => ({ block_type: b.block_type, data: b.data }));

  // Auto-generate slug from title if slug is blank
  titleInput.addEventListener('input', () => {
    if (!slugInput.value || slugInput.dataset.userEdited !== 'true') {
      slugInput.value = titleInput.value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
    }
  });

  slugInput.addEventListener('input', () => {
    slugInput.dataset.userEdited = 'true';
  });

  const renderBlocks = () => {
    container.innerHTML = '';

    if (blocks.length === 0) {
      container.innerHTML = `<div style="text-align: center; padding: 32px; color: var(--muted); font-family: var(--font-body);">No blocks added yet. Click "+ Add Block" buttons above to insert paragraphs, headings, pull quotes, code blocks, or quiz checkpoints.</div>`;
      return;
    }

    blocks.forEach((b, idx) => {
      const card = document.createElement('div');
      card.className = 'block-card';
      card.style.cssText = 'border: 1px solid var(--hairline); padding: 16px; background: #fafafa; position: relative;';

      let innerHtml = `
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; border-bottom: 1px solid var(--hairline); padding-bottom: 8px;">
          <span style="font-family: var(--font-sans); font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--muted);">Block #${idx + 1} — ${b.block_type.toUpperCase()}</span>
          <div style="display: flex; gap: 6px;">
            ${idx > 0 ? `<button type="button" class="btn-up" data-idx="${idx}" style="cursor:pointer; padding: 3px 8px; font-family: var(--font-sans); font-size: 11px;">Move Up</button>` : ''}
            ${idx < blocks.length - 1 ? `<button type="button" class="btn-down" data-idx="${idx}" style="cursor:pointer; padding: 3px 8px; font-family: var(--font-sans); font-size: 11px;">Move Down</button>` : ''}
            <button type="button" class="btn-del" data-idx="${idx}" style="cursor:pointer; padding: 3px 8px; font-family: var(--font-sans); font-size: 11px; color: #d32f2f; border: 1px solid #d32f2f; background: transparent;">Remove Block</button>
          </div>
        </div>
      `;

      if (b.block_type === 'paragraph') {
        innerHtml += `
          <label style="display:block; font-size: 12px; font-weight: 600; margin-bottom: 4px;">Paragraph Text</label>
          <textarea class="arc-input block-field" data-idx="${idx}" data-key="text" rows="4" style="width:100%; font-family: var(--font-body);">${b.data.text || ''}</textarea>
        `;
      } else if (b.block_type === 'heading') {
        innerHtml += `
          <div style="display: grid; grid-template-columns: 120px 1fr; gap: 12px;">
            <div>
              <label style="display:block; font-size: 12px; font-weight: 600; margin-bottom: 4px;">Level</label>
              <select class="arc-input block-field" data-idx="${idx}" data-key="level">
                <option value="2" ${b.data.level == 2 ? 'selected' : ''}>H2 (Section)</option>
                <option value="3" ${b.data.level == 3 ? 'selected' : ''}>H3 (Subhead)</option>
              </select>
            </div>
            <div>
              <label style="display:block; font-size: 12px; font-weight: 600; margin-bottom: 4px;">Heading Text</label>
              <input class="arc-input block-field" data-idx="${idx}" data-key="text" value="${b.data.text || ''}" />
            </div>
          </div>
        `;
      } else if (b.block_type === 'pullquote') {
        innerHtml += `
          <label style="display:block; font-size: 12px; font-weight: 600; margin-bottom: 4px;">Quote Text</label>
          <textarea class="arc-input block-field" data-idx="${idx}" data-key="quote" rows="2" style="width:100%; font-family: var(--font-display);">${b.data.quote || ''}</textarea>
          <label style="display:block; font-size: 12px; font-weight: 600; margin-top: 8px; margin-bottom: 4px;">Attribution (Cite)</label>
          <input class="arc-input block-field" data-idx="${idx}" data-key="cite" value="${b.data.cite || ''}" placeholder="Dr. Isaac Nyantakyi" />
        `;
      } else if (b.block_type === 'callout') {
        innerHtml += `
          <div style="display: grid; grid-template-columns: 1fr 180px; gap: 12px; margin-bottom: 8px;">
            <div>
              <label style="display:block; font-size: 12px; font-weight: 600; margin-bottom: 4px;">Callout Label / Header</label>
              <input class="arc-input block-field" data-idx="${idx}" data-key="title" value="${b.data.title || 'TL;DR'}" placeholder="e.g. TL;DR or KEY TAKEAWAYS" />
            </div>
            <div>
              <label style="display:block; font-size: 12px; font-weight: 600; margin-bottom: 4px;">Style Variant</label>
              <select class="arc-input block-field" data-idx="${idx}" data-key="variant">
                <option value="tldr" ${b.data.variant === 'tldr' ? 'selected' : ''}>TL;DR Paper Box</option>
                <option value="note" ${b.data.variant === 'note' ? 'selected' : ''}>Clean Note Card</option>
                <option value="aside" ${b.data.variant === 'aside' ? 'selected' : ''}>Aside Accent Line</option>
              </select>
            </div>
          </div>
          <label style="display:block; font-size: 12px; font-weight: 600; margin-bottom: 4px;">Callout Text / Bullet Points</label>
          <textarea class="arc-input block-field" data-idx="${idx}" data-key="text" rows="4" style="width:100%; font-family: var(--font-body);" placeholder="Enter summary points, takeaway bullets, or ending notes...">${b.data.text || ''}</textarea>
        `;
      } else if (b.block_type === 'checkpoint') {
        const opts = b.data.options || ['', '', ''];
        innerHtml += `
          <label style="display:block; font-size: 12px; font-weight: 600; margin-bottom: 4px;">Quiz Question</label>
          <input class="arc-input block-field" data-idx="${idx}" data-key="question" value="${b.data.question || ''}" placeholder="How does ACGA relate to GPS?" />
          <div style="margin-top: 10px;">
            <label style="display:block; font-size: 12px; font-weight: 600; margin-bottom: 6px;">Choices (Select radio button for Correct Choice)</label>
            ${opts.map((opt, oIdx) => `
              <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 6px;">
                <input type="radio" name="correct-${idx}" class="correct-radio" data-idx="${idx}" data-oidx="${oIdx}" ${b.data.correct === oIdx ? 'checked' : ''} />
                <input class="arc-input opt-input" data-idx="${idx}" data-oidx="${oIdx}" value="${opt}" placeholder="Option ${oIdx + 1}" style="flex:1;" />
              </div>
            `).join('')}
          </div>
        `;
      } else if (b.block_type === 'code') {
        innerHtml += `
          <label style="display:block; font-size: 12px; font-weight: 600; margin-bottom: 4px;">Language</label>
          <input class="arc-input block-field" data-idx="${idx}" data-key="lang" value="${b.data.lang || 'python'}" style="margin-bottom: 8px;" />
          <label style="display:block; font-size: 12px; font-weight: 600; margin-bottom: 4px;">Code</label>
          <textarea class="arc-input block-field" data-idx="${idx}" data-key="code" rows="5" style="font-family: var(--font-mono);">${b.data.code || ''}</textarea>
        `;
      }

      card.innerHTML = innerHtml;
      container.appendChild(card);
    });

    // Wire block field handlers
    container.querySelectorAll('.block-field').forEach(el => {
      el.addEventListener('input', (e) => {
        const idx = Number(el.dataset.idx);
        const key = el.dataset.key;
        let val = el.value;
        if (key === 'level') val = Number(val);
        blocks[idx].data[key] = val;
      });
    });

    container.querySelectorAll('.opt-input').forEach(el => {
      el.addEventListener('input', () => {
        const idx = Number(el.dataset.idx);
        const oidx = Number(el.dataset.oidx);
        if (!blocks[idx].data.options) blocks[idx].data.options = ['', '', ''];
        blocks[idx].data.options[oidx] = el.value;
      });
    });

    container.querySelectorAll('.correct-radio').forEach(el => {
      el.addEventListener('change', () => {
        const idx = Number(el.dataset.idx);
        const oidx = Number(el.dataset.oidx);
        blocks[idx].data.correct = oidx;
      });
    });

    container.querySelectorAll('.btn-up').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.dataset.idx);
        if (idx > 0) {
          const temp = blocks[idx];
          blocks[idx] = blocks[idx - 1];
          blocks[idx - 1] = temp;
          renderBlocks();
        }
      });
    });

    container.querySelectorAll('.btn-down').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.dataset.idx);
        if (idx < blocks.length - 1) {
          const temp = blocks[idx];
          blocks[idx] = blocks[idx + 1];
          blocks[idx + 1] = temp;
          renderBlocks();
        }
      });
    });

    container.querySelectorAll('.btn-del').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.dataset.idx);
        blocks.splice(idx, 1);
        renderBlocks();
      });
    });
  };

  document.querySelectorAll('.add-block-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const type = btn.dataset.type;
      let initialData = {};
      if (type === 'paragraph') initialData = { text: '' };
      else if (type === 'heading') initialData = { level: 2, text: '' };
      else if (type === 'pullquote') initialData = { quote: '', cite: '' };
      else if (type === 'callout') initialData = { title: 'TL;DR', variant: 'tldr', text: '' };
      else if (type === 'checkpoint') initialData = { question: '', options: ['', '', ''], correct: 0 };
      else if (type === 'code') initialData = { lang: 'python', code: '' };

      blocks.push({ block_type: type, data: initialData });
      renderBlocks();
    });
  });

  renderBlocks();

  // Save Article Submission Handler
  const form = document.getElementById('editor-form');
  const saveBtn = document.getElementById('save-article-btn');

  saveBtn.addEventListener('click', async () => {
    if (!form.reportValidity()) return;

    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving Article...';

    const formData = new FormData(form);
    const articleId = form.dataset.id || undefined;

    const payload = {
      passcode: code,
      id: articleId,
      title: formData.get('title'),
      slug: formData.get('slug'),
      excerpt: formData.get('excerpt'),
      category_id: formData.get('category_id'),
      researcher_id: formData.get('researcher_id'),
      written_by: formData.get('written_by'),
      published_date: formData.get('published_date'),
      featured: formData.get('featured') === 'on',
      featured_image: formData.get('featured_image'),
      audio_url: formData.get('audio_url'),
      audio_duration: formData.get('audio_duration'),
      status: 'published',
      blocks: blocks
    };

    try {
      const res = await fetch('/api/admin/articles', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (data.success) {
        window.location.href = '/admin/articles/';
      } else {
        alert(`Save failed: ${data.error}`);
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save & Publish Article';
      }
    } catch (err) {
      alert('Network error saving article');
      saveBtn.disabled = false;
      saveBtn.textContent = 'Save & Publish Article';
    }
  });
</script>
