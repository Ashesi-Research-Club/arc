---
import Base from '../../../layouts/Base.astro';
import { getArticles } from '../../../lib/supabase';

export const prerender = false;

const articles = await getArticles();
---

<Base title="Articles Desk — ARC Editorial Admin">
  <main>
    <div class="nav-bar">
      <a href="/admin/" class="back-link">← Editorial Desk</a>
      <a href="/admin/articles/editor/" class="arc-button" data-variant="primary">+ Create New Article</a>
    </div>

    <div class="eyebrow">Articles Desk</div>
    <h1>Manage Articles</h1>
    <p class="lede">View, edit, or delete articles and manage content blocks.</p>

    <div class="articles-table-wrap">
      <table class="articles-table">
        <thead>
          <tr>
            <th>Article Title</th>
            <th>Category</th>
            <th>Researcher</th>
            <th>Status</th>
            <th>Claps</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {articles.map((a) => (
            <tr data-id={a.id}>
              <td class="title-cell">
                <a href={`/articles/${a.slug}/`} target="_blank" class="art-title">{a.title}</a>
                <div class="art-meta">Slug: /{a.slug} · Published {a.published_date}</div>
              </td>
              <td><span class="arc-tag">{a.category_id}</span></td>
              <td>{a.researcher?.full_name || a.written_by}</td>
              <td><span class="status-badge" data-status={a.status}>{a.status}</span></td>
              <td class="clap-num">{a.claps || 0} claps</td>
              <td class="action-cell">
                <a href={`/admin/articles/editor/?id=${a.id}`} class="arc-button" data-variant="secondary" style="font-size: 12px; padding: 4px 10px;">Edit Article</a>
                <button type="button" class="del-btn" data-id={a.id} title="Delete article">Delete</button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </main>
</Base>

<style>
  main { max-width: 1040px; margin: 0 auto; padding: 48px 24px 96px; }
  .nav-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
  .back-link { font-family: var(--font-sans); font-size: 13px; font-weight: 600; color: var(--muted); text-decoration: none; }
  
  .eyebrow {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--muted);
  }
  h1 { font-family: var(--font-display); font-weight: 400; font-size: 44px; color: var(--ink); margin: 8px 0; }
  .lede { font-family: var(--font-body); font-size: 18px; color: var(--muted); margin-bottom: 32px; }

  .articles-table-wrap { border: 1px solid var(--ink); overflow-x: auto; background: #fff; }
  .articles-table { width: 100%; border-collapse: collapse; text-align: left; }
  .articles-table th {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    background: #f4f4f4;
    padding: 14px 16px;
    border-bottom: 1px solid var(--ink);
  }
  .articles-table td { padding: 16px; border-bottom: 1px solid var(--hairline); font-family: var(--font-sans); font-size: 14px; }
  .title-cell { max-width: 320px; }
  .art-title { font-family: var(--font-display); font-size: 18px; color: var(--ink); text-decoration: none; display: block; line-height: 1.2; }
  .art-meta { font-size: 12px; color: var(--muted); margin-top: 4px; }
  .status-badge {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 3px 8px;
    background: #e0e0e0;
    color: #333;
  }
  .status-badge[data-status='published'] { background: #e8f5e9; color: #2e7d32; }
  .action-cell { display: flex; gap: 8px; align-items: center; }
  .del-btn {
    background: transparent;
    border: 1px solid var(--hairline);
    color: var(--muted);
    padding: 4px 8px;
    cursor: pointer;
    font-size: 12px;
  }
  .del-btn:hover { border-color: #d32f2f; color: #d32f2f; }

  @media (max-width: 767px) {
    main { padding: 32px 20px 72px; }
  }
</style>

<script>
  // Auth check & article deletion
  const code = sessionStorage.getItem('arc_admin_passcode');
  if (!code) {
    window.location.href = '/admin/';
  }

  document.querySelectorAll('.del-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      if (!id || !confirm('Are you sure you want to delete this article?')) return;

      try {
        const res = await fetch('/api/admin/articles', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ passcode: code, action: 'delete', articleId: id })
        });
        const data = await res.json();
        if (data.success) {
          btn.closest('tr')?.remove();
        } else {
          alert(`Failed to delete: ${data.error}`);
        }
      } catch (err) {
        alert('Error deleting article');
      }
    });
  });
</script>
