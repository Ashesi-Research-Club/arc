---
interface Props { name: string; src?: string; size?: number }
const { name, src, size = 44 } = Astro.props;
const initials = name.split(' ').filter(Boolean).slice(0, 2).map((w) => w[0]?.toUpperCase()).join('');
const hasSrc = Boolean(src && src.trim());
---
<span class="arc-avatar" style={`width:${size}px;height:${size}px;font-size:${Math.round(size * 0.36)}px`}>
  {hasSrc ? (
    <>
      <img
        src={src}
        alt={name}
        loading="lazy"
        decoding="async"
        onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='inline';"
      />
      <span aria-hidden="true" style="display:none">{initials}</span>
    </>
  ) : (
    <span aria-hidden="true">{initials}</span>
  )}
</span>
