---
interface Props { lang?: string }
const { lang = 'code' } = Astro.props;
---
<div class="arc-code">
  <div class="bar">
    <span class="lang">{lang}</span>
    <button type="button" class="copy">Copy</button>
  </div>
  <pre><slot /></pre>
</div>

<style>
  .arc-code { border: 1px solid var(--ink); margin: 0 0 22px; background: var(--tint-paper); }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--ink);
    padding: 8px 12px;
  }
  .lang {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .copy {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--ink);
  }
  pre {
    margin: 0;
    padding: 14px 16px;
    font-family: var(--font-mono);
    font-size: 13.5px;
    line-height: 1.6;
    color: #111;
    overflow-x: auto;
  }
</style>

<script>
  document.querySelectorAll('.arc-code .copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.closest('.arc-code')?.querySelector('pre')?.textContent ?? '';
      await navigator.clipboard.writeText(text);
      btn.textContent = 'Copied';
      setTimeout(() => (btn.textContent = 'Copy'), 1200);
    });
  });
</script>
