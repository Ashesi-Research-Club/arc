---
import PullQuote from './PullQuote.astro';
import Checkpoint from './Checkpoint.astro';
import CodeBlock from './CodeBlock.astro';
import Callout from './Callout.astro';
import Photo from './Photo.astro';
import type { ArticleBlock } from '../lib/supabase';

interface Props {
  blocks: ArticleBlock[];
}

const { blocks } = Astro.props;
---

<div class="article-blocks">
  {blocks.map((block) => {
    switch (block.block_type) {
      case 'heading':
        if (block.data.level === 3) {
          return <h3 id={`heading-${block.order_index}`} class="translatable-text" data-text-en={block.data.text} data-text-fr={block.data.text_fr || ''} data-text-twi={block.data.text_twi || ''}>{block.data.text}</h3>;
        }
        return <h2 id={`heading-${block.order_index}`} class="translatable-text" data-text-en={block.data.text} data-text-fr={block.data.text_fr || ''} data-text-twi={block.data.text_twi || ''}>{block.data.text}</h2>;
      
      case 'pullquote':
        return (
          <div class="translatable-quote" data-quote-en={block.data.quote} data-quote-fr={block.data.quote_fr || ''} data-quote-twi={block.data.quote_twi || ''}>
            <PullQuote cite={block.data.cite}>{block.data.quote}</PullQuote>
          </div>
        );
      
      case 'callout':
        return (
          <div class="translatable-callout" data-title-en={block.data.title || 'TL;DR'} data-text-en={block.data.text} data-title-fr={block.data.title_fr || ''} data-text-fr={block.data.text_fr || ''} data-title-twi={block.data.title_twi || ''} data-text-twi={block.data.text_twi || ''}>
            <Callout title={block.data.title || 'TL;DR'} variant={block.data.variant || 'tldr'}>
              {block.data.text}
            </Callout>
          </div>
        );

      case 'multilingual':
        return (
          <div class="multilingual-block translatable-text" data-text-en={block.data.english} data-text-fr={block.data.french || block.data.english} data-text-twi={block.data.twi || block.data.english}>
            <p class="block-p">{block.data.english}</p>
          </div>
        );
      
      case 'image':
        return (
          <figure class="article-image-block">
            <Photo src={block.data.url} ratio={block.data.ratio || '16/9'} alt={block.data.caption || 'Article image'} label={block.data.caption ? '' : 'Photograph'} />
            {block.data.caption && (
              <figcaption class="image-caption translatable-text" data-text-en={block.data.caption} data-text-fr={block.data.caption_fr || ''} data-text-twi={block.data.caption_twi || ''}>
                {block.data.caption}
              </figcaption>
            )}
          </figure>
        );
      
      case 'checkpoint':
        return (
          <div
            class="translatable-checkpoint"
            data-q-en={block.data.question}
            data-q-fr={block.data.question_fr || ''}
            data-q-twi={block.data.question_twi || ''}
            data-opts-en={JSON.stringify(block.data.options || [])}
            data-opts-fr={JSON.stringify(block.data.options_fr || [])}
            data-opts-twi={JSON.stringify(block.data.options_twi || [])}
          >
            <Checkpoint
              question={block.data.question}
              options={block.data.options}
              correct={block.data.correct}
            />
          </div>
        );
      
      case 'code':
        return <CodeBlock lang={block.data.lang || 'python'}>{block.data.code}</CodeBlock>;
      
      case 'paragraph':
      default:
        return <p class="block-p translatable-text" data-text-en={block.data.text} data-text-fr={block.data.text_fr || ''} data-text-twi={block.data.text_twi || ''}>{block.data.text}</p>;
    }
  })}
</div>

<style>
  .article-blocks {
    display: flex;
    flex-direction: column;
  }
  .block-p {
    font-family: var(--font-body);
    font-size: 19px;
    line-height: 1.65;
    color: var(--ink);
    margin-bottom: 24px;
  }
  h2 {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 400;
    color: var(--ink);
    margin: 40px 0 16px;
    line-height: 1.15;
  }
  h3 {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 400;
    color: var(--ink);
    margin: 32px 0 12px;
    line-height: 1.2;
  }
  .article-image-block {
    margin: 36px 0;
  }
  .image-caption {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--muted);
    margin-top: 10px;
    line-height: 1.45;
  }
</style>
