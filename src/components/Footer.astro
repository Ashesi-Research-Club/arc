---
const sections = [
  ['Computer Science', '/category/computer-science/'],
  ['Engineering', '/category/engineering/'],
  ['Business', '/category/business/'],
  ['Humanities', '/category/humanities/'],
];
const club = [
  ['About', '/about/'],
  ['Team', '/team/'],
  ['Apply', '/apply/'],
  ['Contact', 'mailto:researchclub@ashesi.edu.gh'],
];
---
<footer>
  <div class="cols">
    <div>
      <div class="brand">Ashesi Research Club</div>
      <p class="blurb">Student research, told as a magazine. Published by the Ashesi Research Club, Berekuso, Ghana.</p>
    </div>
    <div>
      <div class="eyebrow">Sections</div>
      <div class="links">{sections.map(([label, href]) => <a href={href}>{label}</a>)}</div>
    </div>
    <div>
      <div class="eyebrow">Club</div>
      <div class="links">{club.map(([label, href]) => <a href={href}>{label}</a>)}</div>
    </div>
    <div>
      <div class="eyebrow">Newsletter</div>
      <p class="pitch">New profiles, in your inbox.</p>
      <form class="signup" id="footer-newsletter">
        <input type="email" name="email" placeholder="Email address" aria-label="Email address" required />
        <button type="submit">Join</button>
      </form>
    </div>
  </div>
  <div class="legal">
    <span>© 2026 Ashesi Research Club</span>
    <span>Berekuso · Ghana</span>
  </div>
</footer>

<script>
  const form = document.getElementById('footer-newsletter') as HTMLFormElement;
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = form.querySelector('input[type="email"]') as HTMLInputElement;
      const email = input.value.trim();
      if (!email) return;

      const btn = form.querySelector('button') as HTMLButtonElement;
      const origText = btn.textContent;
      btn.disabled = true;
      btn.textContent = '...';

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });
        const data = await res.json();
        if (data.success) {
          input.value = '';
          input.placeholder = 'Subscribed!';
          btn.textContent = '✓';
        } else {
          alert(`Subscription failed: ${data.error || 'Please try again'}`);
          btn.disabled = false;
          btn.textContent = origText;
        }
      } catch (err) {
        alert('Network error subscribing to newsletter. Please try again.');
        btn.disabled = false;
        btn.textContent = origText;
      }
    });
  }
</script>

<style>
  footer {
    background: var(--ink);
    color: #fff;
    padding: var(--pad-footer-y) var(--pad-page-x);
  }
  .cols {
    max-width: var(--container-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.4fr;
    gap: 40px;
  }
  .brand { font-family: var(--font-display); font-size: 22px; color: #fff; }
  .blurb {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    color: #bdbdbd;
    max-width: 320px;
    margin: 12px 0 0;
  }
  .eyebrow {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 16px;
  }
  .links { display: flex; flex-direction: column; gap: 10px; }
  .links a { font-family: var(--font-sans); font-size: 14px; color: #cfcfcf; text-decoration: none; }
  .links a:hover { color: #fff; }
  .pitch { font-family: var(--font-body); font-size: 14px; color: #bdbdbd; margin: 0 0 12px; }
  .signup { display: flex; border: 1px solid #fff; }
  .signup input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    outline: none;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 14px;
    padding: 11px 12px;
  }
  .signup input::placeholder { color: #8c8c8c; }
  .signup button {
    background: #fff;
    color: #000;
    border: none;
    padding: 0 16px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }
  .legal {
    max-width: var(--container-max);
    margin: 32px auto 0;
    padding-top: 20px;
    border-top: 1px solid #333;
    display: flex;
    justify-content: space-between;
    font-family: var(--font-sans);
    font-size: 12px;
    color: #8c8c8c;
  }

  @media (max-width: 767px) {
    .cols { grid-template-columns: 1fr; gap: 32px; }
    .legal { flex-direction: column; gap: 6px; }
  }
</style>
